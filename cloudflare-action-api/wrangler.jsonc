{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "order-sheet-action-api",
  "main": "src/index.js",
  "compatibility_date": "2026-08-15",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGIN": "https://tamafit.github.io"
  },
  "kv_namespaces": [
    {
      "binding": "RESULTS",
      "id": "00000000000000000000000000000000"
    }
  ]
}
